		ARG 2 playerPos
		ARG 3 entity
	METHOD matches (Lnet/minecraft/server/level/ServerPlayer;Lnet/minecraft/world/entity/Entity;)Z
		ARG 1 player
		ARG 2 entity
	METHOD wrap (Lnet/minecraft/advancements/critereon/EntityPredicate;)Lnet/minecraft/advancements/critereon/ContextAwarePredicate;
		ARG 0 predicate
