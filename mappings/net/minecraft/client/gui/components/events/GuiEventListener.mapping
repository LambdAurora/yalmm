CLASS net/minecraft/client/gui/components/events/GuiEventListener
	METHOD charTyped (CI)Z
		ARG 1 chr
		ARG 2 keyCode
	METHOD isMouseOver (DD)Z
		ARG 1 mouseX
		ARG 3 mouseY
	METHOD keyPressed (III)Z
		ARG 1 keyCode
		ARG 2 scanCode
		ARG 3 modifiers
	METHOD keyReleased (III)Z
		ARG 1 keyCode
		ARG 2 scanCode
		ARG 3 modifiers
	METHOD mouseClicked (DDI)Z
		ARG 1 mouseX
		ARG 3 mouseY
		ARG 5 button
	METHOD mouseDragged (DDIDD)Z
		ARG 1 mouseX
		ARG 3 mouseY
		ARG 5 button
		ARG 6 deltaX
		ARG 8 deltaY
	METHOD mouseMoved (DD)V
		ARG 1 mouseX
		ARG 3 mouseY
	METHOD mouseReleased (DDI)Z
		ARG 1 mouseX
		ARG 3 mouseY
		ARG 5 button
	METHOD mouseScrolled (DDDD)Z
		ARG 1 mouseX
		ARG 3 mouseY
		ARG 5 scrollX
		ARG 7 scrollY
	METHOD setFocused (Z)V
		ARG 1 focused
