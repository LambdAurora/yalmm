CLASS net/minecraft/client/gui/screens/Screen
	FIELD minecraft client Lnet/minecraft/client/Minecraft;
	METHOD <init> (Lnet/minecraft/network/chat/Component;)V
		ARG 1 title
	METHOD addWidget (Lnet/minecraft/client/gui/components/events/GuiEventListener;)Lnet/minecraft/client/gui/components/events/GuiEventListener;
		ARG 1 widget
	METHOD onFilesDrop (Ljava/util/List;)V
		ARG 1 paths
	METHOD removeWidget (Lnet/minecraft/client/gui/components/events/GuiEventListener;)V
		ARG 1 widget
	METHOD renderBackground (Lnet/minecraft/client/gui/GuiGraphics;IIF)V
		ARG 2 mouseX
		ARG 3 mouseY
		ARG 4 tickDelta
	METHOD renderMenuBackground (Lnet/minecraft/client/gui/GuiGraphics;)V
		ARG 1 graphics
	METHOD renderMenuBackground (Lnet/minecraft/client/gui/GuiGraphics;IIII)V
		ARG 1 graphics
		ARG 2 x
		ARG 3 y
		ARG 4 width
		ARG 5 height
	METHOD renderMenuBackgroundTexture (Lnet/minecraft/client/gui/GuiGraphics;Lnet/minecraft/resources/ResourceLocation;IIFFII)V
		ARG 0 graphics
		ARG 1 texture
		ARG 2 x
		ARG 3 y
		ARG 4 u
		ARG 5 v
		ARG 6 width
		ARG 7 height
	METHOD renderPanorama (Lnet/minecraft/client/gui/GuiGraphics;F)V
		ARG 2 tickDelta
	METHOD renderTransparentBackground (Lnet/minecraft/client/gui/GuiGraphics;)V
		ARG 1 graphics
	METHOD renderWithTooltipAndSubtitles (Lnet/minecraft/client/gui/GuiGraphics;IIF)V
		ARG 1 graphics
		ARG 2 mouseX
		ARG 3 mouseY
		ARG 4 tickDelta
	METHOD resize (II)V
		ARG 1 width
		ARG 2 height
	METHOD runNarration (Z)V
		ARG 1 useTranslationCache
	METHOD triggerImmediateNarration (Z)V
		ARG 1 useTranslationCache
