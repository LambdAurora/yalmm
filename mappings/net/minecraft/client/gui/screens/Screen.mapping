CLASS net/minecraft/client/gui/screens/Screen
	FIELD minecraft client Lnet/minecraft/client/Minecraft;
	METHOD <init> (Lnet/minecraft/network/chat/Component;)V
		ARG 1 title
	METHOD isCopy (I)Z
		ARG 0 keyCode
	METHOD isCut (I)Z
		ARG 0 keyCode
	METHOD isPaste (I)Z
		ARG 0 keyCode
	METHOD isSelectAll (I)Z
		ARG 0 keyCode
	METHOD onFilesDrop (Ljava/util/List;)V
		ARG 1 paths
	METHOD resize (Lnet/minecraft/client/Minecraft;II)V
		ARG 1 client
		ARG 2 width
		ARG 3 height
	METHOD runNarration (Z)V
		ARG 1 useTranslationCache
	METHOD triggerImmediateNarration (Z)V
		ARG 1 useTranslationCache
