CLASS net/minecraft/client/particle/Particle
	FIELD bCol colorBlue F
	FIELD gCol colorGreen F
	FIELD rCol colorRed F
	FIELD xd dX D
	FIELD xo oX D
	FIELD yd dY D
	FIELD yo oY D
	FIELD zd dZ D
	FIELD zo oZ D
	METHOD <init> (Lnet/minecraft/client/multiplayer/ClientLevel;DDDDDD)V
		ARG 1 level
		ARG 2 oX
		ARG 4 oY
		ARG 6 oZ
		ARG 8 dX
		ARG 10 dY
		ARG 12 dZ
	METHOD getLightColor (F)I
		ARG 1 tickDelta
	METHOD move (DDD)V
		ARG 1 x
		ARG 3 y
		ARG 5 z
	METHOD render (Lcom/mojang/blaze3d/vertex/VertexConsumer;Lnet/minecraft/client/Camera;F)V
		ARG 3 tickDelta
	METHOD scale (F)Lnet/minecraft/client/particle/Particle;
		ARG 1 scale
	METHOD setAlpha (F)V
		ARG 1 alpha
	METHOD setBoundingBox (Lnet/minecraft/world/phys/AABB;)V
		ARG 1 boundingBox
	METHOD setColor (FFF)V
		ARG 1 red
		ARG 2 green
		ARG 3 blue
	METHOD setLifetime (I)V
		ARG 1 lifetime
	METHOD setParticleSpeed (DDD)V
		ARG 1 x
		ARG 3 y
		ARG 5 z
	METHOD setPos (DDD)V
		ARG 1 x
		ARG 3 y
		ARG 5 z
	METHOD setSize (FF)V
		ARG 1 width
		ARG 2 height
