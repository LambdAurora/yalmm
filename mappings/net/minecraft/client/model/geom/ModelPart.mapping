CLASS net/minecraft/client/model/geom/ModelPart
	FIELD xRot pitch F
	FIELD yRot yaw F
	FIELD zRot roll F
	METHOD copyFrom (Lnet/minecraft/client/model/geom/ModelPart;)V
		ARG 1 part
	METHOD setPos (FFF)V
		ARG 1 x
		ARG 2 y
		ARG 3 z
	METHOD setRotation (FFF)V
		ARG 1 pitch
		ARG 2 yaw
		ARG 3 roll
	CLASS Vertex
		METHOD <init> (FFFFF)V
			ARG 1 x
			ARG 2 y
			ARG 3 z
			ARG 4 u
			ARG 5 v
		METHOD remap (FF)Lnet/minecraft/client/model/geom/ModelPart$Vertex;
			ARG 1 u
			ARG 2 v
