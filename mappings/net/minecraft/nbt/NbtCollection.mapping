CLASS net/minecraft/nbt/CollectionTag net/minecraft/nbt/NbtCollection
	METHOD addTag addElement (ILnet/minecraft/nbt/Tag;)Z
		COMMENT Inserts NBT {@code element} at {@code index}.
		COMMENT Does nothing if the types were incompatible.
		COMMENT
		COMMENT @return {@code true} if the element was actually added, or {@code false} otherwise
		ARG 1 index
			COMMENT the index at which the NBT element should be inserted at
		ARG 2 element
			COMMENT the NBT element to insert
	METHOD get (I)Lnet/minecraft/nbt/Tag;
		ARG 1 index
	METHOD remove (I)Lnet/minecraft/nbt/Tag;
		ARG 1 index
	METHOD setTag setElement (ILnet/minecraft/nbt/Tag;)Z
		COMMENT Sets the NBT element at {@code index} to {@code element}.
		COMMENT Does nothing if the types were incompatible.
		COMMENT
		COMMENT @return {@code true} if the element was actually set, or {@code false} otherwise
		ARG 1 index
			COMMENT the index at which the NBT element should be set at
		ARG 2 element
			COMMENT the NBT element to set
